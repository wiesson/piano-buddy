{
  "name": "piano-buddy",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "LAN=1 vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "deploy": "convex deploy -y --cmd 'pnpm build' --cmd-url-env-var-name VITE_CONVEX_URL && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@tanstack/react-router": "^1.170.46",
    "@ui-sdk/core": "0.1.0-beta.5",
    "@ui-sdk/react": "0.1.0-beta.5",
    "convex": "^1.50.0",
    "geist": "^1.9.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "smplr": "^1.2.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@edge-runtime/vm": "^5.0.0",
    "@tanstack/router-plugin": "^1.169.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "convex-test": "^0.0.71",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.163.0"
  }
}
