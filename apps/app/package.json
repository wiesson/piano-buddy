{
  "name": "@piano/app",
  "private": true,
  "type": "module",
  "description": "Die Übe-App unter pianobuddy.fyi/app und als iOS-App (Capacitor, gebündelt).",
  "scripts": {
    "dev": "vp dev --port 5198 --strictPort",
    "dev:lan": "LAN=1 vp dev --host --port 5198 --strictPort",
    "build": "tsc -p tsconfig.json && vp build",
    "build:ios": "CAP=1 vp build --mode ios && cap sync ios",
    "preview": "vp preview --port 5198",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo 'Tests der App-Logik liegen in @piano/core'",
    "deploy:worker": "wrangler deploy"
  },
  "dependencies": {
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@piano/core": "workspace:*",
    "@piano/ui": "workspace:*",
    "@tanstack/react-router": "catalog:",
    "@ui-sdk/core": "catalog:",
    "@ui-sdk/react": "catalog:",
    "convex": "^1.51.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "uqr": "^0.1.3",
    "vexflow": "5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "^2.0.0",
    "wrangler": "catalog:",
    "vite-plus": "catalog:"
  }
}
