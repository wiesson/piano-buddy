{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Reine PWA ohne Server-Code: Workers Static Assets liefern dist/ aus.
  "name": "piano-buddy",
  "compatibility_date": "2026-11-01",
  // Eigene Domain; piano-buddy.studionordwerk.workers.dev bleibt zusätzlich erreichbar
  "routes": [{ "pattern": "piano.wiesson.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
